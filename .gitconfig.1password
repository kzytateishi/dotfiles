# 1Password の SSH 鍵でコミット / タグに署名する設定。
# .gitconfig からは読まない (1Password のない SSH 先や devcontainer で commit が失敗するため)。
# 使うマシンでだけ ~/.gitconfig.local に次を書いて有効にする:
#
#   [include]
#     path = ~/workspace/dotfiles/.gitconfig.1password
#   [user]
#     signingkey = ssh-ed25519 AAAA...   # 1Password の SSH 鍵の公開鍵
#
# 前提: 1Password → 設定 → 開発者 →「SSH エージェントを使用」を on にする。

[gpg]
  format = ssh

[gpg "ssh"]
  program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
  # git log --show-signature で手元でも検証できるようにする (中身は「メールアドレス 公開鍵」の 1 行)
  allowedSignersFile = ~/.config/git/allowed_signers

[commit]
  gpgsign = true

[tag]
  gpgsign = true

[core]
  editor = nvim
  precomposeunicode = true
  quotepath = false
  excludesfile = ~/.gitignore_global

[color]
  ui = auto

[column]
  ui = auto
  status = never

[credential]
  # トークンは設定ファイルではなく Keychain に保存する
  helper = osxkeychain

[help]
  autocorrect = prompt

[init]
  defaultBranch = main

[diff]
  renames = true
  colorMoved = default
  algorithm = histogram

[merge]
  conflictstyle = zdiff3
  ff = false
  directoryRenames = conflict

[pull]
  rebase = true

[push]
  default = current
  autoSetupRemote = true

[fetch]
  prune = true
  pruneTags = true

[rebase]
  autostash = true
  autosquash = true

[rerere]
  enabled = true

[tag]
  sort = -version:refname

[alias]
  # Status
  st = status
  ss = status -sb

  # Commit / Branch
  ci = commit
  ca = commit --amend
  can = commit --amend --no-edit
  co = checkout
  cob = checkout -b
  sw = switch
  swc = switch -c
  br = branch
  bvv = branch -vv
  cp = cherry-pick
  cur = rev-parse --abbrev-ref HEAD
  up = rev-parse --abbrev-ref --symbolic-full-name @{u}

  # Log
  lg = log --graph --all --decorate --abbrev-commit --date=short --pretty=format:'%C(red)%h%C(reset) %C(green)[%ad]%C(reset) %s %C(cyan)@%an%C(reset)%C(yellow)%d%C(reset)'
  lo = log --oneline -20
  graph = log --graph --decorate --oneline
  last = log -1 --stat
  show1 = show --stat --oneline HEAD

  # Diff
  dm = diff @{upstream}
  dc = diff --cached
  d1 = diff HEAD~
  d2 = diff HEAD~~
  dw = diff --word-diff
  ds = diff --stat
  name = diff --name-only
  cname = diff --cached --name-only

  # Reset / Restore
  r = reset
  r1 = reset HEAD^
  r2 = reset HEAD^^
  rh = reset --hard
  rh1 = reset HEAD^ --hard
  rh2 = reset HEAD^^ --hard
  rs = restore
  rss = restore --staged

  # Stash
  sl = stash list
  sp = stash pop
  stm = stash push -m

  # Push / Fetch
  p = push
  pf = push --force-with-lease
  fp = fetch --prune --prune-tags

  # Utility
  tags = tag -l
  undo = reset --soft HEAD^
  wip = "!git add -A && git commit -m 'wip'"
  fixup = commit --fixup
  squash = commit --squash
  # main 決め打ちだと master リポジトリで "fatal: malformed object name" になるため
  # origin/HEAD から既定ブランチを解決する (取れなければ HEAD にフォールバック)
  # origin/HEAD → ローカルの main/master → 現在の HEAD の順に解決する。
  # パイプの終了ステータスは sed のものになるので `|| echo` では代替できない。
  default-branch = "!b=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||'); if [ -z \"$b\" ]; then for c in main master; do if git show-ref -q --verify \"refs/heads/$c\"; then b=\"$c\"; break; fi; done; fi; [ -n \"$b\" ] || b=$(git rev-parse --abbrev-ref HEAD 2>/dev/null); printf '%s\\n' \"$b\""
  merged = "!git branch --merged \"$(git default-branch)\""
  unmerged = "!git branch --no-merged \"$(git default-branch)\""
  cop = "!git for-each-ref --format='%(refname:short)' refs/heads | fzf --reverse | xargs -r git switch"

  # NOTE: 以前は $current (実行時にいたブランチ) を skip していたが、
  # 先に $target へ checkout しているので skip は不要であり、
  # 「マージ済みの作業ブランチを消す」という本来の目的が達成できていなかった。
  # 末尾の return 0 は、最後の確認に N と答えたときに alias が exit 1 になるのを防ぐため。
  clear = "!f() { target=\"${1:-$(git default-branch)}\"; git checkout \"$target\" && git fetch -p && for branch in $(git for-each-ref --format='%(refname:short)' refs/heads/); do case \"$branch\" in \"$target\"|main|master|develop) continue;; esac; if git merge-base --is-ancestor \"$branch\" \"$target\"; then printf \"Delete (merged): %s? [y/N] \" \"$branch\"; read ans; [ \"$ans\" = \"y\" ] && git branch -d \"$branch\"; elif ! git ls-remote --exit-code --heads origin \"$branch\" >/dev/null 2>&1; then printf \"Delete (not on origin): %s? [y/N] \" \"$branch\"; read ans; [ \"$ans\" = \"y\" ] && git branch -D \"$branch\"; fi; done; return 0; }; f"

[include]
  path = ~/.gitconfig.local

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
